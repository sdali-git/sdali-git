      "id": "quant-005",
      "topic": "Time & Work",
      "q": "A can finish a job in 12 days and B in 18 days. How long will they take working together?",
      "options": [
        "6 days",
        "7.2 days",
        "7.5 days",
        "8 days"
      ],
      "answer": 1,
      "explanation": "Combined rate = 1/12 + 1/18 = 3/36 + 2/36 = 5/36 of the job per day. Time = 36/5 = 7.2 days."
    },
