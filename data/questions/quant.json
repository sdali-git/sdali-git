      "id": "quant-001",
      "topic": "Profit & Loss",
      "q": "An article is marked 25% above its cost price and sold at a 10% discount. What is the profit percentage?",
      "options": [
        "10%",
        "12.5%",
        "13.5%",
        "15%"
      ],
      "answer": 1,
      "explanation": "Let CP = 100. Marked price = 125. Selling price = 125 × 0.9 = 112.5. Profit = 12.5 on 100, i.e. 12.5%."
    },
    {
      "id": "quant-002",
      "topic": "Simple Interest",
      "q": "What is the simple interest on ₹8,000 at 6% per annum for 3 years?",
      "options": [
        "₹1,240",
        "₹1,440",
        "₹1,520",
        "₹1,600"
      ],
      "answer": 1,
      "explanation": "SI = P × R × T / 100 = 8000 × 6 × 3 / 100 = ₹1,440."
    },
    {
      "id": "quant-003",
      "topic": "Compound Interest",
      "q": "What is the compound interest on ₹10,000 at 10% per annum for 2 years, compounded annually?",
      "options": [
        "₹2,000",
        "₹2,050",
        "₹2,100",
        "₹2,210"
      ],
      "answer": 2,
      "explanation": "Amount = 10000 × 1.1² = ₹12,100. CI = 12,100 − 10,000 = ₹2,100."
    },
