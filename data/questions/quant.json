      "q": "A 240 m long train passes a pole in 12 seconds. What is its speed in km/h?",
      "options": [
        "60 km/h",
        "66 km/h",
        "72 km/h",
        "80 km/h"
      ],
      "answer": 2,
      "explanation": "Speed = 240 / 12 = 20 m/s. 20 × 18/5 = 72 km/h."
    },
