      "q": "What is the LCM of 12, 18 and 30?",
      "options": [
        "90",
        "120",
        "180",
        "360"
      ],
      "answer": 2,
      "explanation": "12 = 2²·3, 18 = 2·3², 30 = 2·3·5. LCM = 2²·3²·5 = 180."
    },
