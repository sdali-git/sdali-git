      "topic": "Percentage",
      "q": "The price of sugar rises by 20%. By what percentage must a family cut consumption to keep spending unchanged?",
      "options": [
        "15%",
        "16⅔%",
        "20%",
        "25%"
      ],
      "answer": 1,
      "explanation": "Reduction = increase / (100 + increase) × 100 = 20/120 × 100 = 16⅔%."
    },
